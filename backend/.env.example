# Configuration de la base de données Neon.tech
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/trustiscore?sslmode=require

# Port du serveur API
PORT=3001

# Mot de passe admin (haché avec bcrypt)
# Pour générer un nouveau hash : node -e "console.log(require('bcrypt').hashSync('VotreMotDePasse', 10))"
ADMIN_PASSWORD_HASH=$2b$10$example_hash_here

# Secret pour les tokens de session (générez-en un unique)
SESSION_SECRET=votre_secret_unique_aleatoire_tres_long

# Environnement (development ou production)
NODE_ENV=development
